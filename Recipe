  margin-top: 6px;
  line-height: 1.4;
}

.yield-box {
  background: var(--tip-bg);
  border: 1px solid var(--tip-border);
  color: var(--tip-ink);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  margin: 14px 0;
  font-size: 0.9rem;
  line-height: 1.5;
}

.note {
  background: var(--warn-bg);
  border: 1px solid var(--warn-border);
  color: var(--warn-ink);
  border-radius: var(--radius-md);
  padding: 13px 15px;
  margin: 16px 0;
  font-size: 0.9rem;
  line-height: 1.5;
}

.tip-box {
  background: #f0fdfa;
  border: 1px solid #99f6e4;
  color: #115e59;
  border-radius: var(--radius-md);
  padding: 12px 14px;
  margin: 14px 0;
  font-size: 0.9rem;
  line-height: 1.5;
}

ol, ul {
  padding-left: 24px;
  margin: 14px 0;
}

li {
  margin: 8px 0;
  line-height: 1.6;
}

/* Flavor Directory Grid */
.flavor-list-grid {

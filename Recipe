    "category": "Soda & Specialty-Inspired Flavors",
    "cat_id": "soda",
    "desc": "The grand finale: electric tart raspberries and crisp fresh lemon juice for an irresistible sparkling cooler.",
    "f2_time": "24\u201336 hours",
    "carb_speed": "Very Fast",
    "taste_notes": "Bold raspberry tartness, bright lemon snap, gorgeous ruby sparkle",
    "ingredients": [
      {
        "name": "Fresh or frozen raspberries",
        "amount": 20,
        "unit": "g",
        "approx": "approx. 6\u20138 berries",
        "prep": "Crushed lightly with a fork"
      },
      {
        "name": "Fresh lemon juice",
        "amount": 10,
        "unit": "g",
        "approx": "approx. 2 tsp",
        "prep": "Freshly squeezed"
      }
    ],
    "prep_tip": "Raspberries provide vibrant color and quick carbonation. Chill thoroughly before opening for crisp, clean effervescence."
  }
];

let activeIndex = 0;

// DOM Elements
const recipeSelect = document.getElementById('recipeSelect');
const recipeSearch = document.getElementById('recipeSearch');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
const randomBtn = document.getElementById('randomBtn');
const recipeCounter = document.getElementById('recipeCounter');

// Part 2 Elements
const recipeCatTag = document.getElementById('recipeCatTag');
const recipeSpeedTag = document.getElementById('recipeSpeedTag');
const recipeTitle = document.getElementById('recipeTitle');
const recipeDesc = document.getElementById('recipeDesc');
const flavorIngredients = document.getElementById('flavorIngredients');
const recipeSteps = document.getElementById('recipeSteps');
const recipeTipText = document.getElementById('recipeTipText');
const flavorListGrid = document.getElementById('flavorListGrid');

function populateSelect(filter = '') {
  const currentVal = Number(recipeSelect.value || activeIndex);
  recipeSelect.innerHTML = '';
  
  const groups = {};
  recipes.forEach((r, idx) => {
    const textTarget = (r.name + ' ' + r.desc + ' ' + r.category + ' ' + r.ingredients.map(i => i.name).join(' ')).toLowerCase();
    if (!filter || textTarget.includes(filter.toLowerCase().trim())) {
      if (!groups[r.category]) groups[r.category] = [];
      groups[r.category].push({ recipe: r, index: idx });
    }
  });

  let count = 0;
  let firstIdx = null;

  for (const [catName, items] of Object.entries(groups)) {
    const optgroup = document.createElement('optgroup');
    optgroup.label = catName;
    items.forEach(item => {
      count++;
      if (firstIdx === null) firstIdx = item.index;
      const opt = document.createElement('option');
      opt.value = item.index;
      opt.textContent = item.recipe.num + '. ' + item.recipe.name;
      if (item.index === activeIndex) opt.selected = true;
      optgroup.appendChild(opt);
    });
    recipeSelect.appendChild(optgroup);
  }

  if (count === 0) {
    const opt = document.createElement('option');
    opt.disabled = true;
    opt.textContent = 'No matching recipes found';
    recipeSelect.appendChild(opt);
  } else {
    const hasCurrent = Array.from(recipeSelect.options).some(o => Number(o.value) === activeIndex);
    if (!hasCurrent && firstIdx !== null) {
      loadRecipe(firstIdx, false);
    }
  }

  recipeCounter.textContent = 'Showing recipe ' + recipes[activeIndex].num + ' of 60 (' + count + ' visible)';
}

function renderFlavorGrid() {
  flavorListGrid.innerHTML = '';
  const filter = (recipeSearch.value || '').toLowerCase().trim();

  recipes.forEach((r, idx) => {
    const textTarget = (r.name + ' ' + r.desc + ' ' + r.category + ' ' + r.ingredients.map(i => i.name).join(' ')).toLowerCase();
    if (filter && !textTarget.includes(filter)) return;

    const div = document.createElement('div');
    div.className = 'flavor-item' + (idx === activeIndex ? ' active' : '');
    div.dataset.index = idx;

    const ingSummary = r.ingredients.map(i => i.name.split(' (')[0] + ' (' + i.amount + i.unit + ')').join(' + ');

    div.innerHTML = '<div>' +
      '<div class="flavor-num">Recipe ' + r.num + ' &middot; ' + r.category.split(' ')[0] + '</div>' +
      '<div class="flavor-name">' + r.name + '</div>' +
      '</div>' +
      '<div class="flavor-ings">' + ingSummary + '</div>';

    div.addEventListener('click', () => {
      loadRecipe(idx);
      document.getElementById('part2Section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    flavorListGrid.appendChild(div);
  });
}

function updateGridActive() {
  const items = flavorListGrid.querySelectorAll('.flavor-item');
  items.forEach(item => {
    const idx = Number(item.dataset.index);
    if (idx === activeIndex) {
      item.classList.add('active');
    } else {
      item.classList.remove('active');
    }
  });
}

function loadRecipe(index, updateSelect = true) {
  if (index < 0) index = 0;
  if (index >= recipes.length) index = recipes.length - 1;
  activeIndex = index;
  const r = recipes[activeIndex];

  recipeCatTag.textContent = r.category;
  recipeSpeedTag.textContent = 'Carbonation: ' + r.carb_speed;
  recipeTitle.textContent = r.name + ' Water Kefir';
  recipeDesc.textContent = r.desc + ' Taste profile: ' + r.taste_notes + '.';

  // Ingredients
  flavorIngredients.innerHTML = '';
  r.ingredients.forEach(ing => {
    const card = document.createElement('div');
    card.className = 'ingredient';
    card.innerHTML = '<div class="ingredient-label">' + ing.name + '</div>' +
      '<div class="amount-display">' +
      '<span class="amount-val">' + ing.amount + '</span>' +
      '<span class="unit">' + ing.unit + '</span>' +
      '</div>' +
      '<div class="approx">' + ing.approx + '</div>' +
      '<div class="prep-note"><strong>Prep:</strong> ' + ing.prep + '</div>';
    flavorIngredients.appendChild(card);
  });

  // Steps
  const ingListText = r.ingredients.map(i => '<strong>' + i.amount + ' ' + i.unit + '</strong> of ' + i.name.toLowerCase() + ' (' + i.prep.toLowerCase() + ')').join(' and ');

  recipeSteps.innerHTML = '<li><strong>Strain the grains:</strong> Strain the grains from the first fermentation jar using your plastic or nylon strainer and set them aside in a clean bowl for your next batch.</li>' +
    '<li><strong>Tare the bottle:</strong> Place your clean 16-oz pressure-rated swing-top glass bottle directly on your digital kitchen scale and tare (zero) it.</li>' +
    '<li><strong>Add flavor ingredients:</strong> Add exactly ' + ingListText + ' directly into the bottle (use a small clean funnel if needed).</li>' +
    '<li><strong>Add plain water kefir:</strong> Pour <strong>~300 grams (about 1.25 cups)</strong> of the strained plain water kefir into the bottle. Crucial: leave about <strong>1 to 2 inches of headspace</strong> at the top so the bottle does not over-pressurize.</li>' +
    '<li><strong>Seal and ferment:</strong> Close the swing-top bottle tightly and let it ferment at room temperature for <strong>' + r.f2_time + '</strong>.</li>' +
    '<li><strong>Burp daily:</strong> Briefly unlatch the bottle once a day over a sink to check carbonation and safely vent excess pressure.</li>' +
    '<li><strong>Chill thoroughly and enjoy:</strong> When carbonated, chill the bottle in the refrigerator for at least 4 to 6 hours before opening. Pour through a fine mesh strainer into your glass to catch fruit solids, and enjoy!</li>';

  recipeTipText.textContent = r.prep_tip;

  if (updateSelect && recipeSelect.value !== String(activeIndex)) {
    recipeSelect.value = String(activeIndex);
  }

  recipeCounter.textContent = 'Showing recipe ' + r.num + ' of 60';
  updateGridActive();
}

recipeSelect.addEventListener('change', () => {
  loadRecipe(Number(recipeSelect.value));
});

recipeSearch.addEventListener('input', () => {
  populateSelect(recipeSearch.value);
  renderFlavorGrid();
});

prevBtn.addEventListener('click', () => {
  const newIdx = activeIndex > 0 ? activeIndex - 1 : recipes.length - 1;
  loadRecipe(newIdx);
});

nextBtn.addEventListener('click', () => {
  const newIdx = activeIndex < recipes.length - 1 ? activeIndex + 1 : 0;
  loadRecipe(newIdx);
});

randomBtn.addEventListener('click', () => {
  const randIdx = Math.floor(Math.random() * recipes.length);
  loadRecipe(randIdx);
});

// Arrow key navigation
document.addEventListener('keydown', (e) => {
  if (document.activeElement === recipeSearch) return;
  if (e.key === 'ArrowLeft') prevBtn.click();
  if (e.key === 'ArrowRight') nextBtn.click();
});

// Init
populateSelect();
renderFlavorGrid();
loadRecipe(0);
</script>
